{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "go",
            "args": ["-C", "${CLAUDE_PROJECT_DIR}", "run", "./cmd/aquas", "hook"]
          }
        ]
      }
    ]
  }
}
