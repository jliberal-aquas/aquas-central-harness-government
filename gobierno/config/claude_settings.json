{
  "agent": "orchestrator",
  "hooks": [
    {"evento": "PreToolUse", "herramientas": ["Write", "Edit", "MultiEdit", "NotebookEdit"], "con_shell": true, "orden": "guard"},
    {"evento": "PostToolUse", "herramientas": ["Edit", "Write"], "orden": "hook"},
    {"evento": "SessionStart", "matcher": "startup|resume|clear|compact", "orden": "memory start"},
    {"evento": "UserPromptSubmit", "orden": "turn open"},
    {"evento": "UserPromptSubmit", "orden": "approval"},
    {"evento": "UserPromptSubmit", "orden": "budget prompt"},
    {"evento": "PreToolUse", "orden": "budget tool"},
    {"evento": "Stop", "orden": "turn close"},
    {"evento": "Stop", "orden": "memory close"},
    {"evento": "Stop", "orden": "proposal"},
    {"evento": "SubagentStop", "matcher": "worker-sonnet|worker-haiku|auditor", "orden": "agent-close"}
  ],
  "por_so": {
    "windows": {"shell": "bash", "herramientas_shell": ["Bash", "PowerShell"]},
    "linux": {"shell": "bash", "herramientas_shell": ["Bash"]},
    "darwin": {"shell": "bash", "herramientas_shell": ["Bash"]}
  }
}
